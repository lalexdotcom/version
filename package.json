{
	"name": "upversion",
	"version": "1.2.0",
	"type": "module",
	"bin": {
		"version": "./dist/index.js"
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rslib build",
		"check": "biome check --write",
		"coverage": "COVERAGE=1 rslib build && c8 --include src --exclude-after-remap --reporter text --reporter html rstest",
		"dev": "rslib build --watch",
		"format": "biome format --write",
		"scratchpad": "tsx scripts/scratchpad.ts",
		"test": "rstest",
		"test:watch": "rstest --watch",
		"version": "tsx src/index.ts",
		"lint": "biome lint"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@lydell/node-pty": "1.2.0-beta.15",
		"@rslib/core": "^1.0.3",
		"@rstest/adapter-rslib": "^0.12.2",
		"@rstest/core": "^0.12.2",
		"@types/node": "^24.12.0",
		"c8": "^12.0.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@clack/prompts": "^1.1.0",
		"commander": "^14.0.3"
	},
	"packageManager": "pnpm@10.31.0",
	"description": "A CLI utility for semantic version management in Node.js projects",
	"license": "MIT",
	"author": {
		"name": "Alexandre LEGOUT",
		"url": "https://github.com/lalexdotcom"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lalexdotcom/version.git"
	},
	"homepage": "https://github.com/lalexdotcom/version#readme",
	"bugs": {
		"url": "https://github.com/lalexdotcom/version/issues"
	},
	"keywords": [
		"version",
		"semver",
		"bump",
		"release",
		"changelog",
		"keep-a-changelog",
		"git",
		"tag",
		"cli"
	],
	"engines": {
		"node": ">=20"
	}
}
